menu "Sensor DHT11"

    config DHT11_GPIO
        int "GPIO data DHT11"
        range 0 48
        default 4

    config SENSOR_PERIOD_S
        int "Periode baca sensor (detik)"
        range 2 3600
        default 10
        help
            DHT11 butuh jeda minimal 1 detik antar pembacaan.

endmenu
