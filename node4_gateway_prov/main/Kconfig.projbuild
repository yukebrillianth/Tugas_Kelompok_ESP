menu "Gateway Wi-Fi dan MQTT"

    config GW_WIFI_SSID
        string "SSID Wi-Fi"
        default "NAMA_WIFI"

    config GW_WIFI_PASSWORD
        string "Password Wi-Fi"
        default ""

    config GW_MQTT_URI
        string "URI broker MQTT"
        default "mqtt://192.168.1.10:1883"
        help
            IP komputer yang menjalankan Mosquitto, port 1883.

endmenu

menu "Kontrol pompa"

    config PUMP_ON_TEMP
        int "Suhu pompa ON (C)"
        default 31
        help
            Pompa ON saat suhu >= nilai ini.

    config PUMP_OFF_TEMP
        int "Suhu pompa OFF (C)"
        default 31
        help
            Pompa OFF saat suhu < nilai ini. Sama dengan suhu ON sesuai brief.
            Isi lebih kecil (misal 30) untuk histeresis.

endmenu
