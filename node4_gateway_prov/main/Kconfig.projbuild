menu "Gateway Wi-Fi dan MQTT"

    config GW_WIFI_SSID
        string "SSID Wi-Fi"
        default "NAMA_WIFI"

    config GW_WIFI_PASSWORD
        string "Password Wi-Fi"
        default ""

    config GW_MQTT_URI
        string "URI broker MQTT"
        default "mqtt://192.168.1.10:1883"
        help
            IP komputer yang menjalankan Mosquitto, port 1883.

endmenu

menu "Kontrol pompa"

    config PUMP_ON_TEMP
        int "Suhu pompa ON (C)"
        default 29
        help
            Pompa ON saat suhu >= nilai ini.

    config PUMP_OFF_TEMP
        int "Suhu pompa OFF (C)"
        default 27
        help
            Pompa OFF saat suhu < nilai ini. Default 27 C (histeresis 2 C)
            supaya pompa tidak mati/nyala sendiri akibat fluktuasi 1 C DHT11.

    config PUMP_MIN_HOLD_S
        int "Durasi tahan minimum status pompa (detik)"
        range 0 300
        default 15
        help
            Jeda minimum sebelum mode auto boleh membalik status pompa.
            Isi 0 untuk menonaktifkan.

endmenu
